# StartupManageSystem local-only environment example.
# Copy to .env.local only if you need to override docker-compose.yml defaults.
# Do not use these values for production.

COMPOSE_PROJECT_NAME=startupmanage_local

SMS_POSTGRES_HOST=127.0.0.1
SMS_POSTGRES_HOST_PORT=55432
SMS_POSTGRES_DB=startupmanage_local
SMS_POSTGRES_USER=startupmanage_app
SMS_POSTGRES_PASSWORD=startupmanage_local_dev_only

DATABASE_URL=postgres://startupmanage_app:startupmanage_local_dev_only@127.0.0.1:55432/startupmanage_local
