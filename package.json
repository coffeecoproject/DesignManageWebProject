{
  "name": "startup-manage-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev:web": "pnpm --filter @startupmanage/web dev",
    "build:web": "pnpm --filter @startupmanage/web build",
    "lint": "pnpm --filter @startupmanage/web lint",
    "test:api": "pnpm --filter @startupmanage/api test",
    "test:web": "pnpm --filter @startupmanage/web test",
    "typecheck": "pnpm --filter @startupmanage/web typecheck && pnpm --filter @startupmanage/api typecheck",
    "typecheck:api": "pnpm --filter @startupmanage/api typecheck",
    "typecheck:web": "pnpm --filter @startupmanage/web typecheck",
    "db:period-close:dry-run": "scripts/local/period-close-postgres-dry-run.sh",
    "db:period-close:apply-drill": "scripts/local/period-close-postgres-apply-drill.sh",
    "db:period-close:replay-drill": "scripts/local/period-close-postgres-replay-drill.sh",
    "db:period-close:concurrency-drill": "scripts/local/period-close-postgres-concurrency-drill.sh",
    "ai-native:next": "node .ai-native/scripts/cli.mjs next ..",
    "ai-native:baseline": "node .ai-native/scripts/cli.mjs baseline ..",
    "ai-native:check": "node .ai-native/scripts/check-startup-adapter.mjs",
    "ai-native:doctor": "pnpm ai-native:next && pnpm ai-native:check",
    "ai-native:claim": "node .ai-native/scripts/cli.mjs claim-control ..",
    "ai-native:context": "node .ai-native/scripts/check-startup-context.mjs",
    "ai-native:launch": "node .ai-native/scripts/check-startup-launch.mjs"
  }
}
